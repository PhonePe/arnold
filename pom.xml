<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.phonepe</groupId>
        <artifactId>pp-parent-pom</artifactId>
        <version>0.132</version>
        <relativePath />
    </parent>

    <groupId>com.phonepe.devx</groupId>
    <artifactId>arnold</artifactId>
    <packaging>pom</packaging>
    <version>1.8-SNAPSHOT</version>

    <modules>
        <module>arnold-core</module>
        <module>arnold-server</module>
        <module>arnold-client</module>
        <module>arnold-models</module>
    </modules>

    <properties>
        <!--intellij module setting-->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!--maven plugins-->
        <maven.plugin.aspectj.version>1.14.0</maven.plugin.aspectj.version>
        <maven.plugin.compiler.version>3.9.0</maven.plugin.compiler.version>
        <maven.plugin.deploy.version>2.8.2</maven.plugin.deploy.version>
        <maven.plugin.docker.version>0.48</maven.plugin.docker.version>
        <maven.plugin.enforcer.version>3.0.0-M2</maven.plugin.enforcer.version>
        <maven.plugin.lombok.version>1.18.20.0</maven.plugin.lombok.version>
        <maven.plugin.shade.version>3.2.0</maven.plugin.shade.version>
        <maven.plugin.surefire.version>3.0.0-M5</maven.plugin.surefire.version>

        <!--platform bundle-->
        <platform.bundle.version>3.0.71</platform.bundle.version>

        <!--support libraries-->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <reflections.version>0.10.2</reflections.version>
        <lombok.version>1.18.36</lombok.version>
        <aspectj.version>1.9.8</aspectj.version>
        <javassist.version>3.26.0-GA</javassist.version>
        <javax.rs.api.version>2.1.1</javax.rs.api.version>

        <!--dropwizard bundles -->
        <dropwizard.version>2.1.12</dropwizard.version>
        <dropwizard.oor.bundle.version>2.0.24-1</dropwizard.oor.bundle.version>
        <dropwizard.rosey.config>2.0.86</dropwizard.rosey.config>
        <dropwizard.rosey.dataprovider.version>2.13</dropwizard.rosey.dataprovider.version>
        <dropwizard.validation.version>1.3.13.5</dropwizard.validation.version>
        <dropwizard.hystrix.version>1.0.2</dropwizard.hystrix.version>
        <ranger.version>2.0.0-RC5</ranger.version>

        <!--hystrix versions-->
        <hystrix.version>1.5.18</hystrix.version>
        <hystrix.function.wrapper.version>1.0.0</hystrix.function.wrapper.version>

        <!-- client libraries-->
        <http.client.version>6.0.14</http.client.version>
        <okhttp.version>5.3.0-PPE</okhttp.version>
        <event.ingestion.client.version>2.1.12-3</event.ingestion.client.version>
        <event.ingestion.models.version>2.0.123</event.ingestion.models.version>
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <json-path.version>2.9.0</json-path.version>
        <olympus-im.version>2.0.60</olympus-im.version>
        <columbus.version>2.1.1</columbus.version>
        <cibot.models.version>1.119</cibot.models.version>


        <!--metrics-->
        <api.metrics.version>0.0.34</api.metrics.version>
        <fuction.metrics.version>1.0.12</fuction.metrics.version>
        <metrics.ingestion.version>1.175</metrics.ingestion.version>

        <!--test libraries-->
        <junit.jupiter.version>5.8.2</junit.jupiter.version>
        <junit.mockito.version>4.2.0</junit.mockito.version>
        <junit.wiremock.version>2.27.2</junit.wiremock.version>
        <hamcrest.version>1.3</hamcrest.version>
        <awaitility.version>3.1.6</awaitility.version>

        <argLine />

        <!--sonar settings-->
        <sonar.coverage.exclusions>
            **com/phonepe/devx/arnold/core/exception/*Mapper*,
            **com/phonepe/devx/arnold/core/guice/*Module*,
            **com/phonepe/devx/arnold/core/guice/bindings/*,
            **com/phonepe/devx/arnold/core/*Configuration*,
            **com/phonepe/devx/arnold/server/*Application*,
            **com/phonepe/devx/arnold/server/events/*Module*,
            **com/phonepe/devx/arnold/server/*Configuration*
        </sonar.coverage.exclusions>

        <sonar.exclusions>
            **src/main/resources/**,
            **/sql/**
        </sonar.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.netflix.hystrix</groupId>
                <artifactId>hystrix-core</artifactId>
                <version>${hystrix.version}</version>
            </dependency>
            <dependency>
                <groupId>io.appform.core</groupId>
                <artifactId>hystrix-function-wrapper</artifactId>
                <version>${hystrix.function.wrapper.version}</version>
            </dependency>

            <!--test-->
            <dependency>
                <groupId>io.dropwizard</groupId>
                <artifactId>dropwizard-testing</artifactId>
                <version>${dropwizard.version}</version>
                <scope>test</scope>
                <exclusions>
                    <exclusion>
                        <groupId>org.glassfish.jersey.test-framework.providers</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.github.tomakehurst</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jayway.jsonpath</groupId>
                <artifactId>json-path</artifactId>
                <version>${json-path.version}</version>
            </dependency>
            <dependency>
                <groupId>com.phonepe.commons.columbus</groupId>
                <artifactId>columbus-bom</artifactId>
                <version>${columbus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.zapodot</groupId>
                <artifactId>hystrix-dropwizard-bundle</artifactId>
                <version>${dropwizard.hystrix.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.dropwizard</groupId>
                        <artifactId>dropwizard-core</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.module</groupId>
                        <artifactId>jackson-module-afterburner</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.phonepe.platform.dw.bundle</groupId>
                <artifactId>platform-bundle-dependencies</artifactId>
                <version>${platform.bundle.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.phonepe.platform.dw.bundle</groupId>
                <artifactId>platform-bundle-bom</artifactId>
                <version>${platform.bundle.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${junit.mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${junit.mockito.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>${junit.mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>clojars</id>
            <name>Clojars repository</name>
            <url>https://repo.clojars.org</url>
        </repository>
    </repositories>

    <profiles>
        <profile>
            <id>docker</id>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <compilerArgument>-parameters</compilerArgument>
                </configuration>
                <version>${maven.plugin.compiler.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven.plugin.deploy.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.plugin.enforcer.version}</version>
                <executions>
                    <execution>
                        <id>no-duplicate-declared-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <banDuplicatePomDependencyVersions />
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-no-snapshots</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireReleaseDeps>
                                    <message>No Snapshots Allowed!</message>
                                </requireReleaseDeps>
                            </rules>
                            <fail>false</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.plugin.surefire.version}</version>
                <configuration>
                    <parallel>classes</parallel>
                    <threadCount>10</threadCount>
                    <forkCount>4</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>@{argLine} -Duser.timezone=IST -Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
