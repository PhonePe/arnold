# Copy to ../.env for docker compose and uncomment what you need. Unset values fall back to the defaults in
# arnold-backend/arnold-server/config/local.yml. Never commit real values.

# GitLab (OAuth application with the `api` scope; callback http://localhost:3000/gitlab/oauth/callback)
# GITLAB_URL=https://gitlab.com
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_SERVICE_TOKEN=
# GITLAB_ACCESS_TOKEN=

# GitHub App (callback http://localhost:3000/github/oauth/callback, webhook /api/github-callbacks/v1/events)
# GITHUB_APP_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=

# Repository sync: imports every open PR/MR from GitHub App installations and GitLab projects (GITLAB_SERVICE_TOKEN)
# ARNOLD_REPOSITORY_SYNC_ENABLED=true
# ARNOLD_REPOSITORY_SYNC_INTERVAL_SECONDS=300
# Comma-separated GitLab group ids/paths; empty imports every project the service token is a member of
# ARNOLD_GITLAB_SYNC_GROUPS=

# Runner LLM endpoint (any OpenAI-compatible API)
# CLIO_HARNESS=opencode
# CLIO_LLM_BASE_URL=https://api.openai.com/v1
# CLIO_LLM_API_KEY=
# OPENCODE_MODELS_URL=https://api.openai.com/v1
# OPENCODE_API_KEY=

# Shared secret between UI sessions and the backend (only used when sign-in is enabled)
# ARNOLD_UI_JWT_SECRET=
ARNOLD_RUNNER_API_KEY=local-runner-key-change-me
